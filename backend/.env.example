# ── IBM watsonx.ai ──────────────────────────────────────────────────────────
# Your IBM Cloud API key (create one at cloud.ibm.com → Manage → Access → API keys)
WATSONX_API_KEY=your_ibm_cloud_api_key_here

# Your watsonx.ai project ID (found in the watsonx.ai project settings)
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# Regional URL for your watsonx instance (default: Dallas)
# Options: https://us-south.ml.cloud.ibm.com  |  https://eu-de.ml.cloud.ibm.com  |  https://eu-gb.ml.cloud.ibm.com  |  https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Supabase (Service-role key — keep secret!) ───────────────────────────────
# Found in your Supabase project: Settings → API → Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Found in: Settings → API → Project API keys → service_role (NOT the anon key)
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
